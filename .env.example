VITE_MAL_CLIENT_ID=
VITE_MAL_REDIRECT_URI=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Server-side only (read by api/en.js). Never prefix it with VITE_, or Vite
# will inline it into the public client bundle.
GEMINI_API_KEY=
# Optional: override the models (defaults: gemini-3.8-flash, then
# gemini-3.5-flash-lite) when Google retires one.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional: storage for "your log on other devices" (api/sync.js). Adding an
# Upstash for Redis store to the project in Vercel (Storage tab) sets these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
